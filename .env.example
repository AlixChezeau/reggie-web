# Copie ce fichier en .env.local et remplis les valeurs (.env.local n'est jamais commité).
# Le site ne fait que lire des données publiques : seule la clé « publishable » de Supabase est utile.
# Jamais de clé secrète (sb_secret_… ou service_role) ici ni dans Vercel pour ce site.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-du-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Adresse publique du site (sitemap, liens de partage)
NEXT_PUBLIC_SITE_URL=https://reggie-web.vercel.app
# Jeton fournisseur App Store Connect (Analytics > Campagnes), pour compter les installations venues du site
NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=
